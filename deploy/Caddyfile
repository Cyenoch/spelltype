{
	# The edge config is fully static for the life of the host: release
	# routing needs no reload and no per-release configuration, so deploying
	# a new game version never restarts or reconfigures the edge and existing
	# sockets on older releases stay connected.
	admin off
}

# Production entry: automatic HTTPS for SPELLTYPE_DOMAIN (deploy/compose.env).
# This variant must only be mounted when SPELLTYPE_DOMAIN holds a real DNS
# name — compose mounts it by default. For plain-HTTP hosts (local Compose
# smoke) mount deploy/Caddyfile.http instead via SPELLTYPE_CADDYFILE.
{$SPELLTYPE_DOMAIN} {
	encode zstd gzip

	# Strict per-release routing: the 32-hex identity is captured from the
	# path and dials the deterministic per-release Docker network alias.
	# Upstream addresses accept placeholders in no-scheme form (validated by
	# .scratch/self-hosted-release/probe against real Caddy + Docker); the
	# full request path is preserved because game apps mount
	# /api/releases/<id> themselves. An unknown or collected release simply
	# has no such alias and fails with a clear 502 — never a fallback to
	# another version.
	@game path_regexp game ^/api/releases/([0-9a-f]{32})(?:/|$)
	handle @game {
		reverse_proxy game-{re.game.1}:3000
	}

	# Immutable per-release client assets. The stable API maps
	# /_releases/<id>/<file> onto the shared assets collection and never
	# falls back to current HTML.
	handle /_releases/* {
		reverse_proxy api:3000
	}

	# Everything else: stable API (root HTML for the active release,
	# /?room=<id> locators, PWA root files, stable /api endpoints).
	handle {
		reverse_proxy api:3000
	}
}
