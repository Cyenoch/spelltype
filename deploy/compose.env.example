# Operator configuration for the spelltype host stack (compose.yaml) and the
# release CLI (scripts/release.mjs). Copy to deploy/compose.env and fill in.
# Never commit the real file; secrets live as files under the state dir.
# First bootstrap (from the repo root):
#   1. Export RELEASE_ADMIN_TOKEN (64 lowercase hex), POSTGRES_PASSWORD and
#      DEEPSEEK_API_KEY, then: bun run deploy secrets
#      Files are created exclusively with mode 0600; existing files are refused.
#   2. bun run deploy stage              # records a new release id A
#   3. bun run deploy api --release-id A # starts database + stable API
#   4. docker compose --env-file deploy/compose.env up -d --no-deps --no-recreate edge
#   5. bun run deploy deploy --release-id A
# Later: bun run deploy deploy --expect A # builds and activates B
# Ordinary game deploys do not restart/reload Caddy, the API, or older games.
# Promote the stable API separately with `api` only when intended.
# Retire with `retire --release-id A`; collection requires a retired release,
# the seven-day asset minimum and keeping the two newest asset sets.
# All schema changes must remain compatible with simultaneous A/B runtimes;
# startup applies forward Drizzle migrations. There is no automatic down migration.
# In a later shell, export RELEASE_ADMIN_TOKEN_FILE=<state dir>/secrets/release_admin_token
# instead of exporting its value; never set both token forms.

# Absolute host path holding assets/, secrets/ and artifacts/.
# Created and maintained by scripts/release.mjs; must exist before first up.
SPELLTYPE_STATE_DIR=/srv/spelltype

# Canonical public origin served by the edge (no path, query or fragment).
SPELLTYPE_PUBLIC_ORIGIN=https://spelltype.example.com

# Compose naming. The base project may be changed to run an isolated
# acceptance stack next to an existing one; the runtime network is derived
# from it unless set explicitly, and game projects are named
# <SPELLTYPE_BASE_PROJECT>-game-<releaseId>.
SPELLTYPE_BASE_PROJECT=spelltype
# SPELLTYPE_RUNTIME_NETWORK=spelltype_runtime

# Host ports: HTTP/HTTPS on the edge, loopback-published admin listener for
# the release CLI. Defaults are production values; override for stacks that
# must coexist with a running deployment.
# SPELLTYPE_HTTP_PORT=80
# SPELLTYPE_HTTPS_PORT=443
# SPELLTYPE_ADMIN_HOST_PORT=3001
# To bind a local acceptance edge only to loopback, set for example
# SPELLTYPE_HTTP_PORT=127.0.0.1:8080 (and a matching public origin).

# DNS name for automatic HTTPS (default TLS variant deploy/Caddyfile).
# Never leave it empty: for plain-HTTP hosts or local Compose smoke, remove
# this line and set SPELLTYPE_CADDYFILE=Caddyfile.http instead.
SPELLTYPE_DOMAIN=spelltype.example.com

# Which static edge config to mount; defaults to the TLS variant.
# SPELLTYPE_CADDYFILE=Caddyfile.http

# Uid/Gid the api and game containers run as. File secrets preserve host
# ownership, so these must match the user that runs scripts/release.mjs
# (creates the 0600 secret files): Linux deploy user 1000/1000, a macOS
# admin host typically 501/20.
SPELLTYPE_UID=1000
SPELLTYPE_GID=1000

# Stable API image promoted by `scripts/release.mjs api`.
SPELLTYPE_API_IMAGE=spelltype/api:stable

# Database identity used for the database_url secret and the postgres container.
POSTGRES_USER=spelltype
POSTGRES_DB=spelltype

# Model used for spell generation inside game runtimes.
DEEPSEEK_MODEL=deepseek-flash

# Game policy for newly started release containers. Existing matches retain their
# recorded policy, and retained deploys do not recreate containers to change it.
MATCH_ADMISSION=open
INPUT_POLICY_MODE=observe
# Use draining to stop new matches and observe while calibrating the input gate;
# enforce rejects completions below the timing floor. Leave/cancel remain available.
# Reporting uses DATABASE_URL[_FILE] directly (not the API or a platform binding):
# bun scripts/input-policy-report.ts --from-ms <inclusive epoch ms> --to-ms <exclusive epoch ms>
