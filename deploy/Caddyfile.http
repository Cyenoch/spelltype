# Plain-HTTP edge for local Compose smoke testing and hosts terminated by an
# external load balancer. Mount this variant by setting
# SPELLTYPE_CADDYFILE=Caddyfile.http in deploy/compose.env. No TLS, no
# redirect; all traffic stays on :80. Routing is identical to the TLS
# variant and equally static: no reload ever happens on a release deploy.
:80 {
	encode zstd gzip

	@game path_regexp game ^/api/releases/([0-9a-f]{32})(?:/|$)
	handle @game {
		reverse_proxy game-{re.game.1}:3000
	}

	handle /_releases/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy api:3000
	}
}
