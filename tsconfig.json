{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node", "bun"],
    "allowImportingTsExtensions": true
  },
  "include": ["src", "shared", "server", "scripts/*.ts", "vite.config.ts", "drizzle.config.ts"]
}
