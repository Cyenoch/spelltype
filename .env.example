# Copy to .env. Bun loads it automatically; never commit credentials.
# Install with bun install, then run bun run dev. Frontend changes use Vite HMR.
# Restart the backend explicitly after server edits; do not use Bun --watch with
# a persistent PGlite owner. Normal Ctrl-C closes it before releasing its claim.
# A crash keeps the claim: remove it only after confirming the owner is stopped.
# Unit tests: bun test ./tests/unit. Browser suite: bun run test:e2e.
# dev/build/deploy/test:e2e disable only Bun 1.4.2's FTL optimization tier: repeated
# valid StyleX media parsing otherwise produces incorrect EOF tokens after warmup.
# Baseline/DFG JIT remain enabled; the production server does not use this override.
DATABASE_URL=pglite://./.data/spelltype
PUBLIC_ORIGIN=http://127.0.0.1:5173
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Admission and input policy apply to the game runtime. A match keeps the policy
# recorded at its start, even after a runtime restart with different settings.
# Use observe while calibrating; enforce rejects completions below the timing floor.
MATCH_ADMISSION=open
INPUT_POLICY_MODE=observe
# MATCH_ADMISSION=draining stops new matches; existing matches remain reachable.
# Calibration: bun scripts/input-policy-report.ts --from-ms <inclusive> --to-ms <exclusive>
# Epoch milliseconds are required. Stop local dev before reporting from its PGlite directory.

# Authentication throttling; invalid values fail startup rather than falling back.
# AUTH_RATE_LIMIT_ATTEMPTS=10
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# Keep false for direct clients. Production Compose explicitly enables it only
# for the stable API behind its private, trusted Caddy peer.
# TRUST_FORWARDED_FOR=false

# Production uses SERVER_ROLE=api or game, PostgreSQL and a pinned release manifest.
# RELEASE_ADMIN_TOKEN must be 32 random bytes encoded as 64 lowercase hex characters.
# DATABASE_URL_FILE, DEEPSEEK_API_KEY_FILE and RELEASE_ADMIN_TOKEN_FILE support mounted secrets.
# Never set both an inline secret and its corresponding *_FILE variable.
