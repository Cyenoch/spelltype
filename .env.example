# Copy to .env. Bun loads it automatically; never commit credentials.
# Install with bun install, then run bun run dev. Frontend changes use Vite HMR.
# Restart the backend explicitly after server edits; do not use Bun --watch with
# a persistent PGlite owner. Normal Ctrl-C closes it before releasing its claim.
# A crash keeps the claim: remove it only after confirming the owner is stopped.
# Unit tests: bun test ./tests/unit. Browser suite: bun run test:e2e.
# Production, Dokploy and CI maintenance runbook: docs/deployment.md.
# dev/build/deploy/test:e2e disable only Bun 1.4.2's FTL optimization tier: repeated
# valid StyleX media parsing otherwise produces incorrect EOF tokens after warmup.
# Baseline/DFG JIT remain enabled; the production server does not use this override.
DATABASE_URL=pglite://./.data/spelltype
PUBLIC_ORIGIN=http://127.0.0.1:5173
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# WeChat is the only login method. Point this at your deployed xsg-website bridge.
# Create an App under xsg-website /developers: it issues this app's App ID and App
# Key, and the App's allowed return hosts (configured per App in that portal) must
# include this PUBLIC_ORIGIN's host:port; the bridge's development mode allows
# local hosts. Callback: <PUBLIC_ORIGIN>/api/auth/wechat/callback. No WeChat
# AppSecret belongs here; the bridge App ID is not a WeChat AppID.
WECHAT_BRIDGE_BASE_URL=
# Public bridge App ID from the xsg-website /developers App.
WECHAT_BRIDGE_APP_ID=
# Server-side App Key from the same App (at least 16 characters); never sent to the browser.
WECHAT_BRIDGE_APP_KEY=
# WECHAT_BRIDGE_APP_KEY_FILE supports a mounted secret; do not set both key forms.
# Leave all three bridge values empty to disable login locally; partial config is rejected.
# Production requires all three values before startup.
# The current WeChat baseline is preserved. Later schema changes use forward migrations.

# Match admission is durable database state, not an environment flag.
# Administrators drain/resume from the signed-in maintenance page; restart never clears it.
# Input policy is recorded at match start and survives runtime restarts.
# Use observe while calibrating; enforce rejects completions below the timing floor.
INPUT_POLICY_MODE=observe
# Calibration: bun scripts/input-policy-report.ts --from-ms <inclusive> --to-ms <exclusive>
# Epoch milliseconds are required. Stop local dev before reporting from its PGlite directory.

# Authentication throttling; invalid values fail startup rather than falling back.
# AUTH_RATE_LIMIT_ATTEMPTS=10
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# Client IP for authentication throttling: unset/empty/false uses the connection IP;
# true reads the rightmost X-Forwarded-For entry; any other value names a single-IP header.
# A missing/empty header falls back to the connection IP. Header names are case-insensitive.
# Configure only behind an ingress that overwrites the selected header and cannot be bypassed.
# TRUST_FORWARDED_FOR=false
# EdgeOne example (instead of false/true):
# TRUST_FORWARDED_FOR=EO-Client-IP

# Production is one application on PostgreSQL. Run db:migrate before start;
# production startup verifies schema but never applies migrations itself.
# Human management uses WeChat sessions and persistent account roles.
# The designated UnionID is granted admin by a forward migration or first verified login.
# Optional CI-only credential: 32 random bytes encoded as 64 lowercase hexadecimal characters.
# MAINTENANCE_TOKEN=
# MAINTENANCE_TOKEN_FILE=/run/secrets/maintenance_token
# This authorizes only /api/ops/maintenance, never the administrator UI or account APIs.
# Remote automation must use HTTPS; never pass this credential in a URL or command argument.
# Leave unset to disable the machine API without disabling signed-in administrators.
# Host-local deployment can also use existing Docker/database permissions.
# DATABASE_URL_FILE and DEEPSEEK_API_KEY_FILE support mounted secrets.
# Never set both an inline secret and its corresponding *_FILE variable.
