{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spelltype",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "DEEPSEEK_MODEL": "deepseek-flash",
  },
  "routes": [
    {
      "pattern": "spelltype.bingzi.dev",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spelltype",
      "database_id": "ca44850c-e7ce-4737-9c52-2d871288eae4",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom",
      },
      {
        "name": "MATCHMAKER",
        "class_name": "Matchmaker",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom", "Matchmaker"],
    },
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
