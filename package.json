{
  "name": "spelltype",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "verify": "bun run format:check && bun run lint && bun run check && bun run test && bun run build",
    "preview": "vite preview",
    "cf:types": "wrangler types",
    "db:local": "wrangler d1 migrations apply spelltype --local",
    "db:remote": "wrangler d1 migrations apply spelltype --remote",
    "art:process": "node scripts/process-art.mjs --source-dir .scratch/artdrop-final",
    "art:check": "node scripts/process-art.mjs --only check",
    "deploy": "bun run build && bun run db:remote && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "bun run test && bun run test:e2e",
    "test:e2e": "playwright test --config tests/playwright.config.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "latest",
    "@hono/zod-validator": "^0.9.1",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/solid-form": "^1.33.5",
    "@tanstack/solid-query": "^5.103.1",
    "@tanstack/solid-router": "^1.170.36",
    "@tanstack/solid-table": "^9.2.4",
    "ai": "latest",
    "hono": "^4.13.8",
    "pixi.js": "^8.0.0",
    "solid-js": "^1.9.15",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@hono/cli": "^0.2.0-next.9",
    "@playwright/test": "latest",
    "@stylexjs/unplugin": "^0.19.1",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "latest",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "sharp": "^0.35.4",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.1",
    "wrangler": "latest"
  }
}
