{
  "name": "spelltype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "preview": "vite preview",
    "cf:types": "wrangler types",
    "db:local": "wrangler d1 migrations apply spelltype --local",
    "art:process": "node scripts/process-art.mjs --source-dir .scratch/artdrop-final",
    "art:check": "node scripts/process-art.mjs --only check",
    "deploy": "bun run build && wrangler deploy",
    "test:e2e": "playwright test --config tests/playwright.config.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "latest",
    "ai": "latest",
    "pixi.js": "^8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "fast-png": "^8.0.0",
    "sharp": "^0.35.4",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  }
}
