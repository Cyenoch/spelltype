{
  "name": "spelltype",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "BUN_JSC_useFTLJIT=false bun scripts/dev.ts",
    "build": "BUN_JSC_useFTLJIT=false bun scripts/build.mjs",
    "start": "NODE_ENV=production bun dist/server/index.js",
    "db:migrate": "bun server/migrate.ts",
    "deploy": "bun scripts/deploy.ts",
    "maintenance": "bun scripts/deploy.ts maintenance",
    "check": "bunx --bun tsc --noEmit -p tsconfig.json && bunx --bun tsc --noEmit -p tests/tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "verify": "bun run format:check && bun run lint && bun run check && bun run test && bun run build",
    "db:generate": "bunx --bun drizzle-kit generate",
    "art:process": "bun scripts/process-art.mjs --source-dir .scratch/artdrop-final",
    "art:ui": "bun scripts/process-ui-art.mjs",
    "art:check": "bun scripts/process-art.mjs --only check",
    "test": "bun test ./tests/unit",
    "test:watch": "bun test --watch ./tests/unit",
    "test:all": "bun run test && bun run test:e2e",
    "test:e2e": "BUN_JSC_useFTLJIT=false bun --bun run playwright test --config tests/playwright.config.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "latest",
    "@electric-sql/pglite": "0.5.8",
    "@hono/zod-validator": "^0.9.1",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/solid-form": "^1.33.5",
    "@tanstack/solid-query": "^5.103.1",
    "@tanstack/solid-router": "^1.170.36",
    "@tanstack/solid-table": "^9.2.4",
    "ai": "latest",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.8",
    "pixi.js": "^8.0.0",
    "solid-js": "^1.9.15",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@hono/cli": "^0.2.0-next.9",
    "@playwright/test": "latest",
    "@stylexjs/unplugin": "^0.19.1",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/bun": "^1.4.2",
    "@types/node": "latest",
    "drizzle-kit": "0.31.10",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "sharp": "^0.35.4",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-solid": "^2.11.14"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
