!package.json
!bun.lock
!index.html
!tsconfig.json
!vite.config.ts
!vite.frontend.ts
!drizzle.config.ts
!drizzle
!drizzle/**
!public
!public/**
!scripts/build.mjs
!shared
!shared/**
!server
!server/**
!src
!src/**
