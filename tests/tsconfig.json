{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "bun"],
    "allowImportingTsExtensions": true
  },
  "include": ["./**/*.ts", "../shared/**/*.ts", "../server/**/*.ts"]
}
