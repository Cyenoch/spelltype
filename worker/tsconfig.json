{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2024"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["./**/*.ts", "../shared", "../worker-configuration.d.ts"]
}
